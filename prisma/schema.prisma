generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  content     String    @db.Text
  published   Boolean   @default(false)
  date        DateTime  @default(now())
  publishedAt DateTime?
  readTime    String
  tags        String[]
  thumbnail   String?
  source      String    @default("manual")
  topic       String?
  keywords    String[]  @default([])
  aiModel     String?
  generatedAt DateTime?
  indexedAt   DateTime?
  indexStatus String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt(sort: Desc)])
}

model GenerationRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  model        String?
  topic        String?
  postId       String?
  error        String?   @db.Text
  cost         Float?
  inputTokens  Int?
  outputTokens Int?

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc)])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model GoogleConnection {
  id           String   @id @default(cuid())
  provider     String   @unique // "google"
  email        String?
  accessToken  String   @db.Text // encrypted (crypto.ts)
  refreshToken String   @db.Text // encrypted
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Keyword {
  id                     String    @id @default(cuid())
  keyword                String    @unique
  geo                    String    @default("2840")
  language               String    @default("1000")
  avgMonthlySearches     Int?
  competition            String?
  competitionIndex       Int?
  lowTopOfPageBidMicros  BigInt?
  highTopOfPageBidMicros BigInt?
  monthlyVolumes         Json?
  source                 String    @default("keyword_planner") // "keyword_planner" | "manual" | "gsc"
  status                 String    @default("new") // "new" | "used" | "ignored"
  postId                 String?
  usedAt                 DateTime?
  fetchedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([avgMonthlySearches(sort: Desc)])
}

model ArticleReview {
  id            String    @id @default(cuid())
  postId        String
  model         String
  status        String
  usedWebSearch Boolean   @default(false)
  claims        Json?
  findings      Json?
  seoNotes      Json?
  suggested     Json?
  sources       Json?
  inputTokens   Int?
  outputTokens  Int?
  cost          Float?
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  @@index([postId, createdAt(sort: Desc)])
}
