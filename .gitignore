# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

/src/generated/prisma

# agent skills (restore locally with: npx skills experimental_install)
/.agents/

# internal docs and agent configuration (local only)
*.md
# except the public repo documentation, which stays version-controlled
!README.md
!DEPLOYMENT.md
!DESIGN.md
/plans/
/opencode.json
/.opencode/
/skills-lock.json
